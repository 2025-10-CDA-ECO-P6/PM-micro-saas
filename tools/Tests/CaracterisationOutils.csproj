<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CaracterisationOutils</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Les outils de `tools/` sont des outils en fichier unique
       (tools/FICHIER-UNIQUE.md) : aucun ProjectReference ne les copie. Chacun
       est compilé une fois par ce build, dans outils/<Outil>/ du répertoire de
       sortie, d'où les tests lancent l'exécutable natif — jamais `dotnet run`,
       dont les lancements parallèles se disputeraient les sorties de compilation.
       Chaque identité est le dossier de l'outil sous tools/, dont le dernier
       segment nomme aussi le fichier d'entrée et le dossier de sortie.
       ComparateurJournaux n'est référencé par aucun test : il n'est pas compilé ici. -->
  <ItemGroup>
    <OutilFichierUnique Include="VerifCorpus;VerifMailleAgregat;VerifMarqueursIdentifiants;VerifCouvertureRecette;CreerIssues;CreerProjet;Harnais/FauxGh;Harnais/GardeIdentiteGh" />
  </ItemGroup>

  <Target Name="CompilerOutilsFichierUnique" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../%(OutilFichierUnique.Identity)/%(OutilFichierUnique.Filename).cs&quot; -o &quot;$(OutDir)outils/%(OutilFichierUnique.Filename)&quot; --nologo -v q" />
  </Target>

</Project>
