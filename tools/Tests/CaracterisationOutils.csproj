<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>CaracterisationOutils</RootNamespace>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CreerIssues\CreerIssues.csproj" />
    <ProjectReference Include="..\CreerProjet\CreerProjet.csproj" />
    <ProjectReference Include="..\Harnais\FauxGh\FauxGh.csproj" />
    <ProjectReference Include="..\Harnais\GardeIdentiteGh\GardeIdentiteGh.csproj" />
  </ItemGroup>

  <!-- Les quatre contrôles du corpus sont des outils en fichier unique
       (tools/FICHIER-UNIQUE.md) : aucun ProjectReference ne les copie. Chacun
       est compilé une fois par ce build, dans outils/<Outil>/ du répertoire de
       sortie, d'où les tests lancent l'exécutable natif — jamais `dotnet run`,
       dont les lancements parallèles se disputeraient les sorties de compilation. -->
  <ItemGroup>
    <OutilFichierUnique Include="VerifCorpus;VerifMailleAgregat;VerifMarqueursIdentifiants;VerifCouvertureRecette" />
  </ItemGroup>

  <Target Name="CompilerOutilsFichierUnique" AfterTargets="Build">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)../%(OutilFichierUnique.Identity)/%(OutilFichierUnique.Identity).cs&quot; -o &quot;$(OutDir)outils/%(OutilFichierUnique.Identity)&quot; --nologo -v q" />
  </Target>

</Project>
