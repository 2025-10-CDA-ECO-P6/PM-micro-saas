<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Version en support à long terme en cours à l'ouverture du build.
         Règle et formulation posées par guide-conventions-et-dod.md §2 — « ce
         guide énonce la règle, jamais un numéro — un numéro vieillit, la règle
         non » — qui renvoie lui-même au §8 pour la pratique de fond dont elle
         découle. Ce commentaire porte la règle et sa source, jamais un numéro
         isolé ni une date. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CreerProjet</RootNamespace>
    <AssemblyName>CreerProjet</AssemblyName>
    <!-- Style porté uniquement par les analyzers livrés avec le SDK — aucune
         dépendance d'analyse tierce dans ce projet. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    SOCLE « LECTURE DU PLAN » PARTAGÉ AVEC tools/CreerIssues — NE JAMAIS DUPLIQUER.

    Les fichiers ci-dessous sont les SOURCES PHYSIQUES de tools/CreerIssues,
    liées ici par chemin plutôt que recopiées : ce dépôt n'a ni fichier de
    solution ni référence de projet entre outils (« un projet par outil »),
    donc rien d'autre qu'un lien de fichier ne peut porter ce partage — et ce
    couplage de chemin est INVISIBLE dans l'arborescence de ce projet. Toute
    modification de ces fichiers doit être faite sous tools/CreerIssues/ et
    revalidée dans LES DEUX projets (`dotnet build` ici ET là-bas) : n'en
    recrée jamais de copie locale sous tools/CreerProjet/, quelle qu'en soit
    la raison.
  -->
  <ItemGroup>
    <Compile Include="../CreerIssues/Chemins.cs" Link="Partage/Chemins.cs" />
    <Compile Include="../CreerIssues/Processus.cs" Link="Partage/Processus.cs" />
    <Compile Include="../CreerIssues/PanneEnvironnementException.cs" Link="Partage/PanneEnvironnementException.cs" />
    <Compile Include="../CreerIssues/ErreurCorpusException.cs" Link="Partage/ErreurCorpusException.cs" />
    <Compile Include="../CreerIssues/TexteUnicode.cs" Link="Partage/TexteUnicode.cs" />
    <Compile Include="../CreerIssues/ReprPython.cs" Link="Partage/ReprPython.cs" />
    <Compile Include="../CreerIssues/LecteurTexte.cs" Link="Partage/LecteurTexte.cs" />
    <Compile Include="../CreerIssues/RacineDepot.cs" Link="Partage/RacineDepot.cs" />
    <Compile Include="../CreerIssues/OrigineGit.cs" Link="Partage/OrigineGit.cs" />
    <Compile Include="../CreerIssues/TableauMarkdown.cs" Link="Partage/TableauMarkdown.cs" />
    <Compile Include="../CreerIssues/BlancPython.cs" Link="Partage/BlancPython.cs" />
    <Compile Include="../CreerIssues/PlanDeTravail.cs" Link="Partage/PlanDeTravail.cs" />
  </ItemGroup>

</Project>
